# Несекретная часть compose/.env для cloud; секреты (SKELCAD_TOKENS) дописывает деплой из Gitea secrets.
APP_PORT=8471
PUBLIC_URL=https://skelcad.br
SKELCAD_SEED=bracket,pipe_support,plate
# Вход для браузера (/, /api, /out): proxy — через oauth2-proxy и Keycloak realm home (см. server/auth.py).
SKELCAD_AUTH=proxy
PROXY_PORT=8472
OIDC_ISSUER_URL=https://auth.br/realms/home
OIDC_CLIENT_ID=skelcad
JOB_TIMEOUT_S=180
LIMIT_CPU_S=170
LIMIT_MEM_MB=3072
WORKER_CPUS=2
WORKER_MEM=4g
# Встроенный агент (задачи из workbench). Провайдер модели — любой с OpenAI-совместимым API:
# LLM_BASE_URL / LLM_MODEL здесь, LLM_API_KEY — секрет Gitea SKELCAD_LLM_API_KEY. Пусто — задачи падают с понятной ошибкой.
AGENT_RUNNER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5
AGENT_MAX_STEPS=60
