# Несекретная часть compose/.env для cloud; секреты (SKELCAD_TOKENS) дописывает деплой из Gitea secrets.
APP_PORT=8471
PUBLIC_URL=https://skelcad.br
SKELCAD_SEED=bracket,pipe_support
# Вход для браузера: none — пока workbench закрыт списком подсетей в nginx; proxy — после шага 2 M2 (Keycloak).
SKELCAD_AUTH=none
JOB_TIMEOUT_S=180
LIMIT_CPU_S=170
LIMIT_MEM_MB=3072
WORKER_CPUS=2
WORKER_MEM=4g
