# Несекретная часть compose/.env для cloud; секреты (SKELCAD_TOKENS) дописывает деплой из Gitea secrets.
APP_PORT=8471
PUBLIC_URL=https://skelcad.br
SKELCAD_SEED=bracket,pipe_support
# Вход для браузера (/, /api, /out): proxy — через oauth2-proxy и Keycloak realm home (см. server/auth.py).
SKELCAD_AUTH=proxy
PROXY_PORT=8472
OIDC_ISSUER_URL=https://auth.br/realms/home
OIDC_CLIENT_ID=skelcad
JOB_TIMEOUT_S=180
LIMIT_CPU_S=170
LIMIT_MEM_MB=3072
WORKER_CPUS=2
WORKER_MEM=4g
